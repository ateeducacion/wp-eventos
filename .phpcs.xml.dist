<?xml version="1.0"?>
<ruleset name="WordPress Coding Standards for Eventos">
	<description>WordPress Coding Standards for the Eventos development repository.</description>

	<file>snippets</file>
	<file>scripts</file>
	<file>src</file>
	<file>tests</file>
	<!-- Generated Code Snippets bundle (edit sources under src/Evt). -->
	<exclude-pattern>/snippets/.*\.bundle\.php$</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/wp/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="WordPress">
		<!-- Snippets, eval-file scripts and tests do not follow the class-file naming scheme. -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- eval-file scripts run in global scope and assign local working variables. -->
		<exclude name="WordPress.WP.GlobalVariablesOverride"/>
	</rule>

	<!--
	Product capabilities: the two application-wide ones registered in
	snippets/roles-and-profiles.php, plus the full set WordPress derives for
	each custom post type from `capability_type` + `map_meta_cap => true`,
	and `switch_users` (WPFront User Role Editor, used by the dev tools).
	-->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="evt_manage_app"/>
				<element value="evt_edit_all_areas"/>
				<element value="switch_users"/>
				<element value="edit_evt_event"/>
				<element value="read_evt_event"/>
				<element value="delete_evt_event"/>
				<element value="edit_evt_events"/>
				<element value="edit_others_evt_events"/>
				<element value="edit_private_evt_events"/>
				<element value="edit_published_evt_events"/>
				<element value="publish_evt_events"/>
				<element value="read_private_evt_events"/>
				<element value="delete_evt_events"/>
				<element value="delete_others_evt_events"/>
				<element value="delete_private_evt_events"/>
				<element value="delete_published_evt_events"/>
				<element value="edit_evt_speaker"/>
				<element value="read_evt_speaker"/>
				<element value="delete_evt_speaker"/>
				<element value="edit_evt_speakers"/>
				<element value="edit_others_evt_speakers"/>
				<element value="edit_private_evt_speakers"/>
				<element value="edit_published_evt_speakers"/>
				<element value="publish_evt_speakers"/>
				<element value="read_private_evt_speakers"/>
				<element value="delete_evt_speakers"/>
				<element value="delete_others_evt_speakers"/>
				<element value="delete_private_evt_speakers"/>
				<element value="delete_published_evt_speakers"/>
				<element value="edit_evt_activity"/>
				<element value="read_evt_activity"/>
				<element value="delete_evt_activity"/>
				<element value="edit_evt_activities"/>
				<element value="edit_others_evt_activities"/>
				<element value="edit_private_evt_activities"/>
				<element value="edit_published_evt_activities"/>
				<element value="publish_evt_activities"/>
				<element value="read_private_evt_activities"/>
				<element value="delete_evt_activities"/>
				<element value="delete_others_evt_activities"/>
				<element value="delete_private_evt_activities"/>
				<element value="delete_published_evt_activities"/>
			</property>
		</properties>
	</rule>

	<!-- PHP compatibility: the code must run on PHP 8.1 or newer. -->
	<config name="testVersion" value="8.1-"/>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
