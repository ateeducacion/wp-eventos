{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/eventos-gestion/",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "login": true,
  "siteOptions": {
    "blogname": "Eventos: encuentros, jornadas y congresos"
  },
  "steps": [
    {
      "step": "setSiteLanguage",
      "language": "es_ES"
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "code-snippets"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "members"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "wpfront-user-role-editor"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "writeFiles",
      "writeToPath": "/wordpress/wp-content/evt-dev/snippets",
      "filesTree": {
        "resource": "git:directory",
        "url": "https://github.com/ateeducacion/wp-eventos.git",
        "ref": "main",
        "path": "snippets",
        "refType": "branch"
      }
    },
    {
      "step": "writeFiles",
      "writeToPath": "/wordpress/wp-content/evt-dev/scripts",
      "filesTree": {
        "resource": "git:directory",
        "url": "https://github.com/ateeducacion/wp-eventos.git",
        "ref": "main",
        "path": "scripts",
        "refType": "branch"
      }
    },
    {
      "step": "writeFiles",
      "writeToPath": "/wordpress/wp-content/evt-dev/src",
      "filesTree": {
        "resource": "git:directory",
        "url": "https://github.com/ateeducacion/wp-eventos.git",
        "ref": "main",
        "path": "src",
        "refType": "branch"
      }
    },
    {
      "step": "writeFiles",
      "writeToPath": "/wordpress/wp-content/mu-plugins",
      "filesTree": {
        "resource": "git:directory",
        "url": "https://github.com/ateeducacion/wp-eventos.git",
        "ref": "main",
        "refType": "branch",
        "path": "scripts/mu-plugins"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; require '/wordpress/wp-content/evt-dev/scripts/sync-snippets.php';"
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; require '/wordpress/wp-content/evt-dev/scripts/provision-roles.php';"
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; require '/wordpress/wp-content/evt-dev/scripts/setup-vocabulary.php';"
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; require '/wordpress/wp-content/evt-dev/scripts/setup-pages.php';"
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; require '/wordpress/wp-content/evt-dev/scripts/seed-demo.php';"
    }
  ],
  "meta": {
    "title": "Eventos — aplicativo de encuentros, jornadas y congresos",
    "author": "ateeducacion",
    "description": "Prueba el aplicativo completo: tipos de contenido, roles, taller del evento e inscripción, con datos de demostración."
  }
}
